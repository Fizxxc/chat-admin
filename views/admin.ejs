<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Inbox</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-6">
  <div class="w-full max-w-3xl bg-white rounded-2xl shadow-xl p-6 space-y-6">

    <!-- Header dan Status -->
    <div class="flex justify-between items-center">
      <h2 class="text-2xl font-bold text-indigo-600">📥 Pesan Masuk</h2>
      <button id="statusBtn" onclick="toggleStatus()" class="px-4 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600 transition">
        Admin Online
      </button>
    </div>

    <!-- Kotak Pesan -->
    <div class="h-72 overflow-y-auto border border-gray-200 rounded-lg p-4 bg-gray-50 space-y-3" id="messages">
      <% messages.forEach(msg => { %>
        <div class="p-3 rounded-lg <%= msg.from === 'admin' ? 'bg-indigo-100 text-right' : 'bg-white' %> shadow-sm">
          <p class="text-sm text-gray-800">
            <strong><%= msg.from === 'admin' ? 'Admin' : 'User' %>:</strong> <%= msg.text %>
          </p>
        </div>
      <% }) %>
    </div>

    <!-- Form Balas -->
    <div class="flex items-center gap-4">
      <input id="reply" type="text" placeholder="Balas pesan..." class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-400">
      <button onclick="reply()" class="px-5 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition">Balas</button>
    </div>
  </div>

  <!-- Socket.IO & Script -->
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    let isOnline = true;

    function toggleStatus() {
      isOnline = !isOnline;
      socket.emit('admin status', isOnline);
      document.getElementById('statusBtn').textContent = isOnline ? 'Admin Online' : 'Admin Offline';
      document.getElementById('statusBtn').className =
        'px-4 py-2 rounded-lg text-white transition ' + (isOnline ? 'bg-green-500 hover:bg-green-600' : 'bg-gray-500 hover:bg-gray-600');
    }

    function reply() {
      const input = document.getElementById('reply');
      const msg = input.value;
      if (msg) {
        socket.emit('admin reply', msg);
        input.value = '';
      }
    }

    socket.on('chat message', (msg) => {
      const div = document.createElement('div');
      div.className = 'p-3 rounded-lg shadow-sm mt-2 ' + (msg.from === 'admin' ? 'bg-indigo-100 text-right' : 'bg-white');
      div.innerHTML = `<p class="text-sm text-gray-800"><strong>${msg.from === 'admin' ? 'Admin' : 'User'}:</strong> ${msg.text}</p>`;
      document.getElementById('messages').appendChild(div);
    });
  </script>  
</body>
</html>
